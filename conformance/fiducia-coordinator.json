{
  "schema_version": 1,
  "protocol": "agent-pontifex.coordinator",
  "protocol_versions": {
    "min_major": 1,
    "max_major": 1
  },
  "service": "coordinator",
  "implementation": "fiducia-cloud-control-plane",
  "capabilities": [
    "coordinator.jobs.cancel",
    "coordinator.jobs.claim",
    "coordinator.jobs.complete",
    "coordinator.jobs.create",
    "coordinator.jobs.heartbeat",
    "coordinator.jobs.idempotency",
    "coordinator.jobs.retry",
    "coordinator.review.human-approval",
    "coordinator.supervision.reconcile"
  ],
  "extensions": {
    "fiducia.authority": {
      "backend": "fiducia-node",
      "linearizable_leases": true,
      "monotonic_fencing": true
    },
    "fiducia.review": {
      "human_approval": true,
      "triad_review": true
    },
    "fiducia.tenancy": {
      "customer_boundary": true,
      "single_tenant": true
    }
  }
}
